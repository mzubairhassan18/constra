# Production (Vercel). Copy to Vercel env vars — never commit real values.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
SESSION_SECRET="64-hex-chars-min"

# Optional — site photos (Cloudflare R2, bucket constra-photos).
# Without these, photo upload is skipped gracefully.
R2_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"
R2_BUCKET="constra-photos"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# Optional — AI phrasing via OpenAI-compatible gateway (offline templates used when unset).
AI_GATEWAY_URL=""
AI_GATEWAY_KEY=""
AI_MODEL="default"
