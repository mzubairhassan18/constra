{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "neon": {
        "type": "remote",
        "url": "https://mcp.neon.tech/mcp"
      },
      "vercel": {
        "type": "remote",
        "url": "https://mcp.vercel.com"
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "oauth": false,
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        }
      }
    }
  }
}
